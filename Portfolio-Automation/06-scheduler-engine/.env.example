# Database configuration
POSTGRES_USER=change_me_postgres_user
POSTGRES_PASSWORD=change_me_postgres_password
POSTGRES_DB=change_me_postgres_db
DATABASE_URL=postgresql+psycopg2://change_me_postgres_user:change_me_postgres_password@db:5432/change_me_postgres_db

# Broker / Celery configuration
REDIS_URL=redis://redis:6379/0

# Alerting / Notification Hub (compatible with 03-multi-channel-notifier and webhook-sink)
ALERT_WEBHOOK_URL=http://webhook-sink:8080/
ALERT_WEBHOOK_TOKEN=change_me_webhook_token
FAILURE_ALERT_THRESHOLD=3

# Security & Execution limits
ALLOW_PRIVATE_TARGETS=false
JOBS_DIR=jobs
EXECUTION_TIMEOUT_SECONDS=30
MAX_OUTPUT_BYTES=100000

# Retry configuration
MAX_RETRIES=3
BASE_BACKOFF_SECONDS=5

# Dashboard configuration
API_URL=http://api:8000
API_KEY=change_me_api_key
