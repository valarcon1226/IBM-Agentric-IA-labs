# Entorno y Configuración de News Aggregator & Intelligence Reporter

# Base de datos PostgreSQL (pgvector + pg_trgm)
POSTGRES_USER=news_user
POSTGRES_PASSWORD=change_me_postgres_password
POSTGRES_DB=newsdb
DATABASE_URL=postgresql://news_user:change_me_postgres_password@postgres:5432/newsdb

# Redis y Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# SMTP & Notificaciones (Mailpit)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=intelligence@news-aggregator.local
DEFAULT_DIGEST_EMAIL=briefing@empresa-ficticia.com

# LLM y Embeddings (Compatible con OpenAI / Ollama / Fake LLM)
LLM_PROVIDER=ollama
LLM_BASE_URL=http://fake_llm:8080/v1
LLM_API_KEY=change_me_llm_api_key
LLM_MODEL=llama3:8b
EMBEDDING_MODEL=nomic-embed-text
SIMILARITY_THRESHOLD=0.15

# Seguridad API
API_BEARER_TOKEN=change_me_api_bearer_token

# Puertos asignados
API_PORT=8009
MAILPIT_UI_PORT=8029
ALLOW_PRIVATE_TARGETS=false
