POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_postgres_password
POSTGRES_DB=restaurant_db
DATABASE_URL=postgresql://postgres:change_me_postgres_password@postgres:5432/restaurant_db

LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=change_me_llm_api_key
LLM_MODEL=llama-3.3-70b-versatile
# Tests/local demos only: routes the agent to a scripted fake LLM instead of a real endpoint.
# Never set this to true outside tests or a deliberate offline demo.
LLM_FAKE=false

WHATSAPP_ENABLED=false
WHATSAPP_TOKEN=change_me_whatsapp_token
WHATSAPP_PHONE_NUMBER_ID=change_me_phone_number_id
WHATSAPP_APP_SECRET=change_me_whatsapp_app_secret
WHATSAPP_VERIFY_TOKEN=change_me_verify_token
GRAPH_API_VERSION=v23.0
GRAPH_API_BASE=https://graph.facebook.com

STAFF_WA_IDS=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_ID=
REMINDER_TEMPLATE=hello_world

DEV_MODE=true
DEV_API_KEY=change_me_dev_api_key
