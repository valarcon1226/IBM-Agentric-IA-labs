# Sabor de Casa — n8n automation pack (DECISIONES-14 A3).
# `.env.example` only: never create or edit a real `.env` file. Run with
# `docker compose --env-file .env.example up -d --wait`. Every value here is a placeholder —
# `change_me_...` — and gets consumed as discrete environment variables, never baked into a
# single credentialed connection URL (same pattern as 02/03/13).

# --- Postgres (shared by n8n's own backend and the business tables in init-db.sql) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_postgres_password
POSTGRES_DB=n8n_automation_pack

# --- n8n ---
# Encrypts credentials at rest (A3). Must stay the same between n8n-init and n8n.
N8N_ENCRYPTION_KEY=change_me_n8n_encryption_key_32_chars_min

# --- Webhook protection (A3) ---
# F1/F2 inbound webhooks: Header Auth, header name `X-Api-Key`.
WEBHOOK_API_KEY=change_me_webhook_api_key
# F4 payment webhook: HMAC-SHA256 secret, header `X-Signature: sha256=<hex>`.
PAYMENT_WEBHOOK_SECRET=change_me_payment_webhook_secret

# --- LLM (F2 invoice extraction, F3 daily summary; A4) ---
# Local: fake-llm (deterministic, no account). Production: point these at OmniRoute/Groq/OpenAI
# and put a real key in LLM_API_KEY — no workflow edit needed, F2/F3 read $env.LLM_BASE_URL /
# $env.LLM_MODEL and use the "LLM API Key" Header Auth credential.
LLM_BASE_URL=http://fake-llm:8000/v1
LLM_MODEL=fake-llm-v1
LLM_API_KEY=change_me_llm_api_key
