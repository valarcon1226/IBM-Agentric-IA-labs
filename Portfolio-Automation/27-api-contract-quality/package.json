{
  "name": "27-api-contract-quality",
  "version": "1.0.0",
  "description": "API Quality Suite: Consumer-Driven Contracts (Pact), Property-Based Fuzzing (Schemathesis), and Automated API Regression (Postman/Newman)",
  "private": true,
  "scripts": {
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" --fix",
    "format:check": "prettier --check \"**/*.{ts,json,md,yml,yaml}\"",
    "format": "prettier --write \"**/*.{ts,json,md,yml,yaml}\"",
    "test:consumer": "jest --testPathPattern=tests/consumer --runInBand",
    "publish:pact": "ts-node scripts/publish-pact.ts",
    "can-i-deploy": "ts-node scripts/can-i-deploy.ts",
    "verify:provider": "ts-node scripts/verify-provider.ts",
    "test:newman": "ts-node scripts/run-newman.ts",
    "test:schemathesis": "powershell -Command \"$env:PYTHONIOENCODING='utf-8'; .venv\\Scripts\\schemathesis.exe run http://127.0.0.1:8000/openapi.json --wait-for-schema=30 --checks not_a_server_error,status_code_conformance,content_type_conformance,response_schema_conformance --max-examples 25 --workers 1\""
  },
  "devDependencies": {
    "@pact-foundation/pact": "^13.2.0",
    "@types/jest": "^29.5.12",
    "@types/newman": "^5.3.6",
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "axios": "^1.7.7",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "newman": "^6.1.3",
    "prettier": "^3.3.3",
    "ts-jest": "^29.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}
