POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_postgres_password
POSTGRES_DB=leads_db
DATABASE_URL=postgresql://postgres:change_me_postgres_password@postgres:5432/leads_db

API_KEY=change_me_api_key

# Google Places Text Search — optional source, only used when set (DECISIONES-08 L1: no Google
# Maps scraping, the official API is the only way this project touches Google Maps data).
GOOGLE_PLACES_API_KEY=

# Polite scraping (DECISIONES-08 L1): identifiable User-Agent, 1 req/s per domain by default.
SCRAPER_USER_AGENT=LeadGeneratorBot/1.0 (+https://example.com/leadbot)
SCRAPER_RATE_LIMIT_PER_SECOND=1.0

# demo-directory service (compose network name; batch B wires the container).
DEMO_DIRECTORY_BASE_URL=http://demo-directory

FUZZY_MATCH_THRESHOLD=85
EMAIL_MX_TIMEOUT_SECONDS=3.0
