# Copy to .env and fill in real values. Never commit .env.
LITELLM_MASTER_KEY=sk-change-me
# Open WebUI base URL used by scripts/ingest.py and evals/run.py
OPENWEBUI_BASE_URL=http://127.0.0.1:8088
# Model evaluated by evals/run.py
EVAL_MODEL=primary-model
# Per-call timeout in seconds for chat requests
EVAL_TIMEOUT_S=300
