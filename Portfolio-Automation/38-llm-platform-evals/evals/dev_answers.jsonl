{"pass": 1, "id": "GOLD-022", "answerable": true, "gold_doc_paths": ["workloads/pods/init-containers.md"], "key_fact_regexes": ["init containers", "complete"], "answer": "Init containers differ from app containers in that they run before app containers in a Pod and complete their execution before any app containers start [0]. They can have a separate view of the filesystem and access to Secrets that app containers cannot access [0]. Additionally, init containers can securely run utilities or custom code that would otherwise make an app container image less secure, by keeping unnecessary tools separate [0].", "top_sources": ["workloads/pods/init-containers.md", "containers/_index.md", "workloads/pods/sidecar-containers.md", "workloads/pods/_index.md", "overview/_index.md"], "citations": ["workloads/pods/init-containers.md", "workloads/pods/init-containers.md", "workloads/pods/init-containers.md", "workloads/pods/init-containers.md", "workloads/pods/init-containers.md", "workloads/pods/init-containers.md", "workloads/pods/init-containers.md", "workloads/pods/init-containers.md", "workloads/pods/init-containers.md", "workloads/pods/init-containers.md", "workloads/pods/init-containers.md", "workloads/pods/init-containers.md", "workloads/pods/init-containers.md", "workloads/pods/init-containers.md", "workloads/pods/init-containers.md"], "answered_by": "qwen3:4b-instruct-2507-q4_K_M", "seconds": 32.1, "attached": [["workloads/pods/init-containers.md", "workloads/pods/init-containers.md", "workloads/pods/init-containers.md", "workloads/pods/init-containers.md", "workloads/pods/init-containers.md"]]}
{"pass": 1, "id": "GOLD-035", "answerable": true, "gold_doc_paths": ["security/pod-security-standards.md"], "key_fact_regexes": ["Privileged", "Baseline", "Restricted"], "answer": "The three Pod Security Standards policy levels are Privileged, Baseline, and Restricted. These policies range from highly-permissive to highly-restrictive and are cumulative in nature [0]. The Restricted policy enforces current Pod hardening best practices, targeting security-critical applications and lower-trust users [0].", "top_sources": ["security/security-checklist.md", "security/pod-security-standards.md", "security/pod-security-admission.md", "workloads/pods/_index.md", "services-networking/network-policies.md"], "citations": ["security/security-checklist.md", "security/pod-security-standards.md", "security/security-checklist.md", "security/pod-security-standards.md", "security/pod-security-admission.md", "security/security-checklist.md", "security/pod-security-standards.md", "security/security-checklist.md", "security/pod-security-standards.md", "security/pod-security-admission.md"], "answered_by": "qwen3:4b-instruct-2507-q4_K_M", "seconds": 37.9, "attached": [["security/security-checklist.md", "security/pod-security-standards.md", "security/security-checklist.md", "security/pod-security-standards.md", "security/pod-security-admission.md"]]}
