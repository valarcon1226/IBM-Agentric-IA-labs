# Lista blanca: el repo es público y esta carpeta tiene .env, sesiones de login, jobs.db, CVs y
# el perfil personal. Se ignora todo y solo se versiona el código.
/*
!/.gitignore
!/*.py
!/Dockerfile
!/docker-compose.yml
!/requirements.txt
!/PROGRESS.md
!/skill_estimates_curated.json
!/APPLICATOR_PLAN.md
!/COMO_USARLO.md
!/CV_TEMPLATE/
/CV_TEMPLATE/*
!/CV_TEMPLATE/cv_template.html
